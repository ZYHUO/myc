# Toggle: use built-in mock data instead of calling the real API.
# Set to "false" when running against a real sub2api backend.
VITE_USE_MOCK=true

# Base URL for the real backend (only consulted when VITE_USE_MOCK=false).
# In dev, the Vite proxy already forwards /api to http://localhost:8080,
# so the default empty value is fine for local development.
VITE_API_BASE_URL=
