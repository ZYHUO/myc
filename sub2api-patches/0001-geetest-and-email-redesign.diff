+	var lastErr error
+	// Try Geetest first when present, since the SPA prefers it when both
+	// are enabled. A successful pass short-circuits the OR.
+	if geetestOn && geetestToken != "" {
+		if err := s.VerifyGeetest(ctx, geetestToken, remoteIP); err == nil {
+			return nil
+		} else {
+			lastErr = err
+		}
+	}
+	if turnstileOn && turnstileToken != "" {
+		if err := s.VerifyTurnstile(ctx, turnstileToken, remoteIP); err == nil {
+			return nil
+		} else {
+			lastErr = err
+		}
+	}
+	if lastErr != nil {
+		return lastErr
+	}
+	// No tokens supplied at all but at least one provider is enabled.
+	// Prefer Geetest's error class when Geetest is the active provider,
+	// Turnstile's otherwise — matches what the frontend was showing.
+	if geetestOn {
+		return ErrGeetestVerificationFailed
+	}
+	return ErrTurnstileVerificationFailed
+}
+
+// VerifyCaptchaForRegister mirrors VerifyCaptcha but skips re-validation
+// during the register-with-verify-code flow (the captcha token was burned
+// at send-code time).
