+// VerifyGeetest validates a Geetest v4 token if (and only if) Geetest is
+// enabled. Returns nil when the feature is off, mirroring the
+// VerifyTurnstile contract — callers can call both unconditionally and
+// each one no-ops when its respective switch is off. When BOTH CAPTCHAs
+// are enabled, the auth handler must pass each its own token; we don't
+// fall through one to the other.
+func (s *AuthService) VerifyGeetest(ctx context.Context, token string, remoteIP string) error {
+	if s.geetestService == nil {
+		return nil
+	}
+	return s.geetestService.VerifyToken(ctx, token, remoteIP)
+}
+
+// VerifyGeetestForRegister mirrors the Turnstile equivalent: when the
+// register call carries a verify-code the user already passed Geetest
+// during the send-code call, so skip a second validation to avoid the
+// one-shot challenge being reused.
+func (s *AuthService) VerifyGeetestForRegister(ctx context.Context, token, remoteIP, verifyCode string) error {
+	if s.IsEmailVerifyEnabled(ctx) && strings.TrimSpace(verifyCode) != "" {
+		return nil
+	}
+	return s.VerifyGeetest(ctx, token, remoteIP)
+}
+
+// IsGeetestEnabled 检查是否启用 Geetest v4 验证
+func (s *AuthService) IsGeetestEnabled(ctx context.Context) bool {
+	if s.geetestService == nil {
+		return false
+	}
+	return s.geetestService.IsEnabled(ctx)
+}
+
+// VerifyCaptcha validates whichever of Turnstile / Geetest the client
+// supplied. When NEITHER is enabled, returns nil (no captcha required).
+// When AT LEAST ONE is enabled, at least one supplied token must pass —
+// it's an OR, not an AND. This matches what the SPA actually does (one
+// widget on screen at a time even when admin has both enabled), and
+// keeps the UX sane: the user doesn't have to solve two challenges.
+//
+// Edge cases:
+//   - All providers off                       → pass
+//   - Geetest on, token valid                 → pass
+//   - Geetest on, token empty/invalid;
+//     Turnstile on, token valid               → pass
+//   - All enabled providers got empty/bad
+//     tokens                                  → return last verifier error
+//
+// Returns the most informative error from the failing verifier so the
+// frontend can surface a precise message.
+func (s *AuthService) VerifyCaptcha(ctx context.Context, turnstileToken, geetestToken, remoteIP string) error {
+	turnstileOn := s.IsTurnstileEnabled(ctx)
+	geetestOn := s.IsGeetestEnabled(ctx)
+	if !turnstileOn && !geetestOn {
+		return nil
+	}
